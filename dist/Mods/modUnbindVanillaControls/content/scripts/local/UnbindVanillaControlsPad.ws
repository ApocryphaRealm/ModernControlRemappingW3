// =====================================================================================================================
// Unbind Vanilla Controls - the CONTROLLER ROWS under the diagram of Settings > Controller Scheme.
//
// The rows are the INPUTPAD rows of the hidden group UvcPadInput (bin\config\r4game\user_config_matrix\pc\uvc_pad.xml,
// generated by tools/gen_menu.py). The game writes an INPUTPAD row's value to the pad side of every action on it, in
// every context, and leaves the keyboard alone (probe 1, 2026-10-06). The mod's Controller Scheme page (panel_ingamemenu,
// GamepadMappingModule) shows the rows of the tab on show and calls OnChangeKeybind / OnClearKeybind with a row's tag,
// as the Key Bindings page does; UnbindVanillaControls.ws sends those calls here when the tag is a controller row.
//
// WHY THE LIST WAS PARKED, AND WHAT KEEPS IT SAFE NOW (2026-10-14; the owner: "the control scheme menu doesn't have the
// interaction point for you to select to and view what buttons do what in which context and change them"). On 2026-10-06
// the list could CLEAR a row (X, Delete, or the row's own button again), which wrote IK_None - and the game never writes
// a pad button over IK_None (or over another pad layout's key): the row could not be given a button again from anywhere
// in the game, and the read-back said it had one (probes 4-6, logic library). So:
//   - the list never writes IK_None: X and Delete change nothing on a controller row, and OnClearKeybind below
//     writes nothing;
//   - UNBIND (the owner, 2026-10-14: "if you select the same button that's already bound to it, it should unbind it")
//     is A, then the row's own button: the page sends the row's OFF SWITCH for the tab on show (9000 + tab,
//     UVC_TogglePadRowOff), so the control stops answering there while its binding stays in input.settings - the game
//     never sees IK_None. The row shows "-"; A and any button binds it again (the switch goes back on, and a new button
//     is written over the kept Xbox binding, which lands). Rows with no off switch cannot be unbound;
//   - a row whose control has no Xbox button in the game's live mapping now (cleared before, or a PlayStation key) is
//     shown locked: A does not start a change, and the script refuses a write to it (UVC_PadRowLocked) - the write
//     would not land, and the row would claim a button it does not have.
// =====================================================================================================================

function UVC_IsPadRow(config : CInGameConfigWrapper, keybindName : name) : bool
{
	return config.DoVarHasTag('UvcPadInput', keybindName, 'uvc_pad');
}

// The value an INPUTPAD row takes is one key's name ALONE. Probe 2 (Main Agent, 2026-10-06): "IK_Pad_DigitLeft" moved SpawnHorse's
// pad lines and read back "IK_Pad_DigitLeft"; the two-slot forms "IK_None;IK_Pad_DigitRight" and "IK_Pad_X_SQUARE;IK_None"
// (the INPUTPC shape) left the actions on IK_None. Any set also replaces the action's pad PATTERN lines
// (IK_Pattern_CallHorse, the double press that calls Roach).

// The pad button's name from the NUMBER the page sends (KeyCode.PAD_A_CROSS 136 ... PAD_RIGHT_TRIGGER 151). 1.0.0's first
// owner run bound Strong Attack to RT and Fast Attack to RB and both rows lost their buttons with nothing written: the
// binder took the name from the event's EInputKey and a name outside its table read as "none", which matched the cleared
// row. The number is what the page sends; the name comes from this table only; "" means "do not write".
function UVC_PadKeyName(code : int) : string
{
	switch (code)
	{
		case 136: return "IK_Pad_A_CROSS";
		case 137: return "IK_Pad_B_CIRCLE";
		case 138: return "IK_Pad_X_SQUARE";
		case 139: return "IK_Pad_Y_TRIANGLE";
		case 140: return "IK_Pad_Start";
		case 141: return "IK_Pad_Back_Select";
		case 142: return "IK_Pad_DigitUp";
		case 143: return "IK_Pad_DigitDown";
		case 144: return "IK_Pad_DigitLeft";
		case 145: return "IK_Pad_DigitRight";
		case 146: return "IK_Pad_LeftThumb";
		case 147: return "IK_Pad_RightThumb";
		case 148: return "IK_Pad_LeftShoulder";
		case 149: return "IK_Pad_RightShoulder";
		case 150: return "IK_Pad_LeftTrigger";
		case 151: return "IK_Pad_RightTrigger";
	}
	return "";
}

// The pad button codes the page uses (KeyCode.PAD_A_CROSS 136 ... PAD_RIGHT_TRIGGER 151 = the engine's IK_Pad_*).
function UVC_PadKeyCode(keyName : string) : int
{
	switch (keyName)
	{
		case "IK_Pad_A_CROSS":       return 136;
		case "IK_Pad_B_CIRCLE":      return 137;
		case "IK_Pad_X_SQUARE":      return 138;
		case "IK_Pad_Y_TRIANGLE":    return 139;
		case "IK_Pad_Start":         return 140;
		case "IK_Pad_Back_Select":   return 141;
		case "IK_Pad_DigitUp":       return 142;
		case "IK_Pad_DigitDown":     return 143;
		case "IK_Pad_DigitLeft":     return 144;
		case "IK_Pad_DigitRight":    return 145;
		case "IK_Pad_LeftThumb":     return 146;
		case "IK_Pad_RightThumb":    return 147;
		case "IK_Pad_LeftShoulder":  return 148;
		case "IK_Pad_RightShoulder": return 149;
		case "IK_Pad_LeftTrigger":   return 150;
		case "IK_Pad_RightTrigger":  return 151;
	}
	return 0;
}

// The pad button a row has now: the first pad button named in its value, whichever slot it is in; 0 for none.
function UVC_PadRowKey(config : CInGameConfigWrapper, row : name) : int
{
	var parts : array<string>;
	var value : string;
	var left, right : string;
	var code : int;

	value = config.GetVarValue('UvcPadInput', row);
	while (StrSplitFirst(value, ";", left, right))
	{
		parts.PushBack(left);
		value = right;
	}
	parts.PushBack(value);
	for (code = 0; code < parts.Size(); code += 1)
	{
		if (UVC_PadKeyCode(parts[code]) > 0)
		{
			return UVC_PadKeyCode(parts[code]);
		}
	}
	return 0;
}

// A row's control has no Xbox pad button in the game's LIVE mapping (theInput, not the settings read-back, which reports
// what was asked rather than what was written): a pad write to it would not land.
function UVC_PadRowLocked(row : name) : bool
{
	var keys : array<EInputKey>;
	var action : name;
	var keyName : string;
	var i : int;

	action = UVC_PadRowFirstAction(row);
	if (action == '')
	{
		return true;
	}
	theInput.GetPadKeysForAction(action, keys);
	for (i = 0; i < keys.Size(); i += 1)
	{
		keyName = keys[i];
		if (UVC_PadKeyCode(keyName) > 0)
		{
			return false;
		}
	}
	return true;
}

function UVC_TabTag(tab : int) : name
{
	switch (tab)
	{
		case 0: return 'uvc_tab0';
		case 1: return 'uvc_tab1';
		case 2: return 'uvc_tab2';
		case 3: return 'uvc_tab3';
		case 4: return 'uvc_tab4';
	}
	return '';
}

function UVC_TabBit(tab : int) : int
{
	switch (tab)
	{
		case 0: return 1;
		case 1: return 2;
		case 2: return 4;
		case 3: return 8;
		case 4: return 16;
	}
	return 0;
}

function UVC_TabName(tab : int) : string
{
	switch (tab)
	{
		case 0: return GetLocStringByKeyExt("ControlLayout_ExplorationLayoutTitle");
		case 1: return GetLocStringByKeyExt("ControlLayout_SwinningLayoutTitle");
		case 2: return GetLocStringByKeyExt("ControlLayout_CombatLayoutTitle");
		case 3: return GetLocStringByKeyExt("ControlLayout_HorseLayoutTitle");
		case 4: return GetLocStringByKeyExt("ControlLayout_BoatLayoutTitle");
	}
	return "";
}

// Every controller row to the page: label, pad button, tag, and a bit per tab. A row in more than one tab says which -
// its key moves in all of them.
function UVC_SendPadRows(storage : CScriptedFlashValueStorage)
{
	var config : CInGameConfigWrapper;
	var rows : CScriptedFlashArray;
	var row : CScriptedFlashObject;
	var rowName : name;
	var label, shared : string;
	var count, i, tab, tabs, inTabs, offTabs : int;
	var offVar : name;

	config = theGame.GetInGameConfigWrapper();
	rows = storage.CreateTempFlashArray();
	count = config.GetVarsNumByGroupName('UvcPadInput');
	for (i = 0; i < count; i += 1)
	{
		rowName = config.GetVarNameByGroupName('UvcPadInput', i);
		tabs = 0;
		inTabs = 0;
		offTabs = 0;
		shared = "";
		for (tab = 0; tab < 5; tab += 1)
		{
			if (config.DoVarHasTag('UvcPadInput', rowName, UVC_TabTag(tab)))
			{
				tabs += UVC_TabBit(tab);
				inTabs += 1;
				offVar = UVC_RowOffVar(rowName, tab);
				if (offVar != '' && config.GetVarValue('UvcPadTabsOff', offVar) == "true")
				{
					offTabs += UVC_TabBit(tab);
				}
				shared += (shared == "" ? "" : ", ") + UVC_TabName(tab);
			}
		}
		label = GetLocStringByKeyExt(config.GetVarDisplayName('UvcPadInput', rowName));
		if (inTabs > 1)
		{
			label += "  <font color='#7a7a7a'>(" + shared + ")</font>";
		}
		row = storage.CreateTempFlashObject();
		row.SetMemberFlashString("label", label);
		row.SetMemberFlashInt("key", UVC_PadRowKey(config, rowName));
		row.SetMemberFlashUInt("tag", NameToFlashUInt(rowName));
		row.SetMemberFlashInt("tabs", tabs);
		row.SetMemberFlashInt("offTabs", offTabs);
		row.SetMemberFlashBool("gate", config.DoVarHasTag('UvcPadInput', rowName, 'uvc_gate'));
		row.SetMemberFlashBool("locked", UVC_PadRowLocked(rowName));
		rows.PushBackFlashObject(row);
	}
	storage.SetFlashArray("ingamemenu.uvc.padrows", rows);
	// the line over the rows, in the game's own words: A - Select, Start - Cancel. Unbinding is A then the row's own
	// button (the header); there is no Delete and no separate off key
	storage.SetFlashString("ingamemenu.uvc.padhint", "A - " + GetLocStringByKeyExt("panel_button_common_select")
		+ "     Start - " + GetLocStringByKeyExt("panel_common_cancel"));
	// the word a row shows in a tab where it is off
	storage.SetFlashString("ingamemenu.uvc.padoff", GetLocStringByKeyExt("panel_mainmenu_option_value_off"));
}

// The page asks for the rows whenever it shows the controller diagram. (Parked from 2026-10-06 to 2026-10-14 - the
// header says why and what changed.)
@wrapMethod(CR4IngameMenu)
function SendControllerData()
{
	wrappedMethod();
	UVC_SendPadRows(m_flashValueStorage);
}

function UVC_SetPadRow(menu : CR4IngameMenu, row : name, value : string)
{
	var config : CInGameConfigWrapper;

	config = theGame.GetInGameConfigWrapper();
	LogChannel('UnbindVanillaControls', "Controller Scheme: " + row + " = " + value);
	config.SetVarValue('UvcPadInput', row, value);
	theGame.SaveUserSettings();
}

// Gives a row one pad button and checks that the row reads it back.
function UVC_BindPadRow(menu : CR4IngameMenu, row : name, key : EInputKey)
{
	var config : CInGameConfigWrapper;
	var keyName : string;

	config = theGame.GetInGameConfigWrapper();
	keyName = UVC_PadKeyName((int)key);
	if (keyName == "")
	{
		// not a pad button the row can take: write nothing, so the row keeps what it had
		LogChannel('UnbindVanillaControls', "Controller Scheme: " + row + " - code " + (int)key + " is not a pad button, nothing written");
		return;
	}
	if (UVC_PadRowLocked(row))
	{
		// no Xbox button in the live mapping: the write would not land and the row would claim it (the header)
		LogChannel('UnbindVanillaControls', "Controller Scheme: " + row + " has no Xbox pad button in the game's mapping - nothing written");
		return;
	}
	if (UVC_PadRowKey(config, row) == UVC_PadKeyCode(keyName))
	{
		// its own button again: nothing to change (it never clears a controller row)
		return;
	}
	UVC_SetPadRow(menu, row, keyName);
	if (UVC_PadRowKey(config, row) != UVC_PadKeyCode(keyName))
	{
		LogChannel('UnbindVanillaControls', "Controller Scheme: " + row + " did not read back " + keyName);
	}
}

// The tab from the off-switch code the page sends: 9000 + tab as an int. The "unbind by same button" build sent the sum
// as a Number, and the engine handed the script the FLOAT's bit pattern (owner's run, 2026-10-14: "PadStrongAttack has no
// off switch in tab 1175223512" = 9000.0f - 9000, "PadSprint ... 1175224536" = 9001.0f - 9000). The page now sends an
// int; the float form is read too: 9000.0f is 0x460CA000 (1175232512) and each 1.0 more adds 1024 at this exponent.
// -1 for anything else.
function UVC_PadTabFromCode(code : int) : int
{
	var k : int;

	if (code >= 9000 && code <= 9004)
	{
		return code - 9000;
	}
	if (code >= 1175232512 && code <= 1175232512 + 4 * 1024)
	{
		k = code - 1175232512;
		if (k % 1024 == 0)
		{
			return k / 1024;
		}
	}
	return -1;
}

// The row's off switches, for the log: "tab0=<var or -> tab1=..."
function UVC_PadRowOffTable(row : name) : string
{
	var s : string;
	var tab : int;
	var v : name;

	s = "";
	for (tab = 0; tab < 5; tab += 1)
	{
		v = UVC_RowOffVar(row, tab);
		if (v == '')
		{
			s += " tab" + tab + "=-";
		}
		else
		{
			s += " tab" + tab + "=" + NameToString(v);
		}
	}
	return s;
}

// Unbind (the row's own button again) or bind again: the page sends OnChangeKeybind with 9000 + the tab on show, a code
// no key has. The row's control turns off in that tab (or on again); UnbindVanillaControlsGate.ws skips it there.
function UVC_TogglePadRowOff(row : name, tab : int)
{
	var config : CInGameConfigWrapper;
	var offVar : name;

	config = theGame.GetInGameConfigWrapper();
	offVar = UVC_RowOffVar(row, tab);
	LogChannel('UnbindVanillaControls', "Controller Scheme: off switch for " + row + " in tab " + tab + " -> '" + NameToString(offVar) + "'; the row's switches:" + UVC_PadRowOffTable(row));
	if (offVar == '')
	{
		LogChannel('UnbindVanillaControls', "Controller Scheme: " + row + " has no off switch in tab " + tab);
		return;
	}
	if (config.GetVarValue('UvcPadTabsOff', offVar) == "true")
	{
		config.SetVarValue('UvcPadTabsOff', offVar, "false");
	}
	else
	{
		config.SetVarValue('UvcPadTabsOff', offVar, "true");
	}
	theGame.SaveUserSettings();
}

// OnClearKeybind is an event: no early return in this wrapper (logic library, AMF Witcher 3). A controller row is never
// cleared: IK_None is the one value the game cannot write a button over again (the header).
@wrapMethod(CR4IngameMenu)
function OnClearKeybind(keybindTag : name)
{
	if (UVC_IsPadRow(mInGameConfigWrapper, keybindTag))
	{
		LogChannel('UnbindVanillaControls', "Controller Scheme: clear on " + keybindTag + " refused - a controller row is never set to IK_None");
		UVC_SendPadRows(m_flashValueStorage);
	}
	else
	{
		wrappedMethod(keybindTag);
	}
}
