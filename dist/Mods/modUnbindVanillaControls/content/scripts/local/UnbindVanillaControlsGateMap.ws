// The first action of each controller row: the action whose live pad key decides whether the row can change.
function UVC_PadRowFirstAction(row : name) : name
{
	switch (row)
	{
		case 'PadSprint': return 'Sprint';
		case 'PadSprintToggle': return 'SprintToggle';
		case 'PadJump': return 'Jump';
		case 'PadClimb': return 'ExplorationInteraction';
		case 'PadExplorationRoll': return 'Roll';
		case 'PadTalk': return 'Talk';
		case 'PadLoot': return 'Container';
		case 'PadGatherHerbs': return 'GatherHerbs';
		case 'PadMountHorse': return 'MountHorse';
		case 'PadOpen': return 'Open';
		case 'PadFastTravel': return 'FastTravel';
		case 'PadExamine': return 'Examine';
		case 'PadInteract': return 'PickOilLamp';
		case 'PadFastAttack': return 'AttackLight';
		case 'PadStrongAttack': return 'AttackHeavy';
		case 'PadCastSign': return 'CastSign';
		case 'PadParry': return 'LockAndGuard';
		case 'PadFocus': return 'Focus';
		case 'PadDodge': return 'Dodge';
		case 'PadCombatRoll': return 'CbtRoll';
		case 'PadQuickItem': return 'ThrowItem';
		case 'PadCancelAim': return 'ThrowCastAbort';
		case 'PadRadialMenu': return 'RadialMenu';
		case 'PadCameraLock': return 'CameraLock';
		case 'PadChangeObjective': return 'HighlightObjective';
		case 'PadTrackQuest': return 'TrackQuest';
		case 'PadSummonHorse': return 'SpawnHorse';
		case 'PadPotion1': return 'DrinkPotion1';
		case 'PadPotion2': return 'DrinkPotion2';
		case 'PadWeapon': return 'SteelSword';
		case 'PadOilSteel': return 'OilSteel';
		case 'PadOilSilver': return 'OilSilver';
		case 'PadGallop': return 'Gallop';
		case 'PadHorseJump': return 'HorseJump';
		case 'PadHorseDismount': return 'HorseDismount';
		case 'PadHorseAttack': return 'VehicleAttack';
		case 'PadHorseCastSign': return 'VehicleCastSign';
		case 'PadHorseQuickItem': return 'VehicleItemAction';
		case 'PadDive': return 'DiveDown';
		case 'PadSurface': return 'DiveUp';
		case 'PadBoatAccelerate': return 'GI_Accelerate';
		case 'PadBoatReverse': return 'GI_Decelerate';
		case 'PadDisembark': return 'BoatDismount';
	}
	return '';
}
